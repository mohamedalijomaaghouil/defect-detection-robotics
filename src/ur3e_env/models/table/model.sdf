<?xml version="1.0"?>
<sdf version="1.7">
  <model name="table">
    <static>true</static>

    <link name="table_link">

      <!-- Collision -->
      <collision name="collision">
        <geometry>
          <box>
            <size>1.2 0.8 0.75</size>
          </box>
        </geometry>
      </collision>

      <!-- Visual -->
      <visual name="visual">
        <geometry>
          <box>
            <size>1.2 0.8 0.75</size>
          </box>
        </geometry>
        <material>
          <ambient>0.6 0.45 0.3 1</ambient>
          <diffuse>0.6 0.45 0.3 1</diffuse>
        </material>
      </visual>

    </link>
  </model>
</sdf>

